# Copia este archivo como .env.local y completa los valores.
# Nunca subas el .env.local al repositorio.

# Neon Postgres (connection string con pooler — ver console.neon.tech)
DATABASE_URL=

# Better Auth (Sprint 2)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# UploadThing (Sprint 5 — fotos y documentos)
# Token del dashboard: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=

# Resend (Sprint 6)
RESEND_API_KEY=
