# Copia este archivo como .env.local y completa los valores.
# Nunca subas el .env.local al repositorio.

# Neon Postgres (connection string con pooler — ver console.neon.tech)
DATABASE_URL=

# Better Auth (Sprint 2)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# UploadThing (Sprint 5 — fotos y documentos)
# Token del dashboard: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=

# Resend (Sprint 6 — emails de alertas)
# API key: https://resend.com → API Keys (3.000 correos/mes gratis)
# Sin dominio verificado, Resend solo envía desde onboarding@resend.dev
# a tu propio email. RESEND_FROM es opcional (ej. "ChronoDevice <alerts@tudominio.com>")
RESEND_API_KEY=
RESEND_FROM=

# Vercel Cron (Sprint 6 — trabajo diario de alertas)
# Secreto que Vercel manda como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
